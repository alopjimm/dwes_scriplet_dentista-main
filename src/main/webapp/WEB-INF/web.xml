<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
  <display-name>Gestión Clínica Dental</display-name>
  <servlet>
    <servlet-name>pacientes</servlet-name>
    <servlet-class>es.dwes.dentista.web.PacientesServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>pacientes</servlet-name>
    <url-pattern>/pacientes</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>citas</servlet-name>
    <servlet-class>es.dwes.dentista.web.CitasServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>citas</servlet-name>
    <url-pattern>/citas</url-pattern>
  </servlet-mapping>
  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>
</web-app>